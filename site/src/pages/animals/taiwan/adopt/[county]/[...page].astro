---
import type { GetStaticPaths } from "astro";
import AnimalCounty from "../../../../../components/AnimalCounty.astro";
import { counties, PAGE_SIZE } from "../../../../../lib/animals";

export const getStaticPaths = (({ paginate }) =>
  (counties("animals-adopt") ?? []).flatMap((c) => paginate(c.cases, { params: { county: c.slug }, props: { area: c.area }, pageSize: PAGE_SIZE }))) satisfies GetStaticPaths;
const { page, area } = Astro.props;
---
<AnimalCounty topic="animals-adopt" area={area} page={page} />
