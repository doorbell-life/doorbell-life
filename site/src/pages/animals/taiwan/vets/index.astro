---
// 動物醫院名錄首頁：縣市清單＋「用我的位置排序」。
// 位置只在訪客自己的瀏覽器裡計算，不送出、不儲存（CLAUDE.md §3 第 6 條例外一）。
import Base from "../../../../layouts/Base.astro";
import { REPORT_URL, TOWNS_SOURCE, VETS_SOURCE, vetCounties } from "../../../../lib/vets";

const list = vetCounties();
const total = list?.reduce((n, c) => n + c.total, 0) ?? 0;
const fmt = (n: number) => n.toLocaleString("en-US");
// 給位置排序用：只放有醫院、有中心點的鄉鎮
const points = (list ?? []).flatMap((c) =>
  c.districts.filter((d) => d.center).map((d) => ({ n: `${c.county}${d.name}`, u: `/animals/taiwan/vets/${c.slug}/${d.slug}/`, c: d.vets.length, p: d.center })),
);
---
<Base title="附近的動物醫院，依縣市鄉鎮查詢｜按門鈴" lang="zh-Hant-TW" description={`全台 ${fmt(total)} 家領有開業執照的獸醫診療機構，依縣市、鄉鎮列出電話與地址。資料來自農業部防檢署開放資料。`}>
  <main>
    <h1>附近有哪些動物醫院？</h1>
    {list ? (
      <p class="lead">全台有 {fmt(total)} 家領有開業執照的獸醫診療機構。選縣市和鄉鎮，就能看到電話和地址；也可以按下面的按鈕，依你的位置找最近的鄉鎮。</p>
    ) : (
      <p class="lead">名錄資料尚未同步，稍後再來看。</p>
    )}

    {points.length > 0 && (
      <section class="near">
        <button type="button" id="near">用我的位置排序</button>
        <p class="muted">位置只在你的手機或電腦上計算，不會傳給我們，也不會被記錄。距離以鄉鎮中心點估算，不是到醫院的實際距離。</p>
        <p id="near-msg" class="muted" aria-live="polite"></p>
        <ol id="near-list"></ol>
        <script type="application/json" id="near-data" set:html={JSON.stringify(points)} />
      </section>
    )}

    {list && (
      <>
        <h2>選縣市</h2>
        <ul class="counties">
          {list.map((c) => <li><a href={`/animals/taiwan/vets/${c.slug}/`}>{c.county}</a><span>{fmt(c.total)} 家</span></li>)}
        </ul>
      </>
    )}

    <h2>出發前先打電話</h2>
    <ul>
      <li>官方資料沒有營業時間，也沒有寫是否有 24 小時急診、看不看兔子、鳥類等特殊寵物。出發前請先打電話確認。</li>
      <li>知道哪家有 24 小時急診或看特殊寵物？歡迎<a href={REPORT_URL}>回報給我們</a>，查證後會標註。</li>
      <li>官方資料每半年更新一次，可能還列著已經歇業的醫院。</li>
      <li>資料來源：<a href={VETS_SOURCE.url}>{VETS_SOURCE.name}</a>；鄉鎮中心點：<a href={TOWNS_SOURCE.url}>{TOWNS_SOURCE.name}</a>。</li>
    </ul>
  </main>
</Base>
<script>
  // 只用 textContent 產生內容；位置不存、不送出。
  const btn = document.getElementById("near");
  const msg = document.getElementById("near-msg")!;
  const out = document.getElementById("near-list")!;
  const data: { n: string; u: string; c: number; p: [number, number] }[] = JSON.parse(document.getElementById("near-data")?.textContent || "[]");
  const km = (a: [number, number], b: [number, number]) => {
    const r = Math.PI / 180;
    const h = Math.sin(((b[0] - a[0]) * r) / 2) ** 2 + Math.cos(a[0] * r) * Math.cos(b[0] * r) * Math.sin(((b[1] - a[1]) * r) / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(h));
  };
  btn?.addEventListener("click", () => {
    if (!navigator.geolocation) {
      msg.textContent = "這個瀏覽器不支援定位，請直接選縣市。";
      return;
    }
    msg.textContent = "正在取得位置…";
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const me: [number, number] = [pos.coords.latitude, pos.coords.longitude];
        const near = data.map((d) => ({ ...d, k: km(me, d.p) })).sort((a, b) => a.k - b.k).slice(0, 8);
        out.textContent = "";
        for (const d of near) {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = d.u;
          a.textContent = d.n;
          li.append(a, ` 約 ${Math.round(d.k)} 公里・${d.c} 家`);
          out.append(li);
        }
        msg.textContent = "離你最近的鄉鎮：";
      },
      () => {
        msg.textContent = "沒有取得位置（可能沒有允許定位），請直接選縣市。";
      },
      { maximumAge: 600000, timeout: 15000 },
    );
  });
</script>
<style>
  .counties { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 8px 24px; }
  .counties li { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--border-subtle); padding: 8px 0; }
  .counties span { color: var(--text-secondary); }
  .near { margin: 32px 0; padding: 24px; background: var(--bg-surface); border-radius: 12px; }
  #near { font: inherit; font-weight: 600; padding: 12px 24px; border: 0; border-radius: 8px; background: var(--text-primary); color: var(--bg-base); cursor: pointer; }
  #near-list li { margin: 4px 0; }
</style>
