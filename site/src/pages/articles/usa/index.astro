---
import Base from "../../../layouts/Base.astro";
import { articleUrl, regionArticles, TOPIC_LABEL_EN, type ArticleTopic } from "../../../lib/articles";

const all = await regionArticles("usa");
const groups = (Object.keys(TOPIC_LABEL_EN) as ArticleTopic[])
  .map((t) => ({ t, list: all.filter((a) => a.data.topic === t) }))
  .filter((g) => g.list.length > 0);
---
<Base title="Articles: missing persons, blood donation, animals, error pages | doorbell.life" region="usa" description="One question per article: what to do when someone goes missing, who can give blood, how to adopt a pet, how to build a useful error page. Every article cites official US sources.">
  <main>
    <h1>Articles</h1>
    <p class="lead">Each article answers one question, and the first sentence is the answer. Every article lists its official US sources and the date they were checked.</p>
    {groups.length === 0 && <p>Articles are still being written.</p>}
    {groups.map((g) => (
      <section>
        <h2>{TOPIC_LABEL_EN[g.t]}</h2>
        <ul>
          {g.list.map((a) => (
            <li><a href={articleUrl(a)}>{a.data.title}</a><span class="muted">{a.data.description}</span></li>
          ))}
        </ul>
      </section>
    ))}
  </main>
</Base>
<style>
  li { margin-bottom: 16px; }
  li .muted { display: block; }
</style>
