---
// 可列印的精簡檢查表（§9 臨時照顧系列）。獨立頁面、沒有導覽列，適合 A4 列印貼在冰箱上。
import { getCollection } from "astro:content";
import "../../../../../styles/tokens.css";

export async function getStaticPaths() {
  const all = await getCollection("articles", (a) => a.data.region === "taiwan" && !!a.data.checklist);
  return all.map((a) => ({ params: { topic: a.data.topic, slug: a.id.split("/").pop()! }, props: { a } }));
}
const { a } = Astro.props;
const url = `https://doorbell.life/articles/taiwan/${a.data.topic}/${a.id.split("/").pop()}/`;
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{a.data.title}：檢查表｜按門鈴</title>
  </head>
  <body>
    <main>
      <h1>{a.data.title}</h1>
      <ol>{a.data.checklist!.map((c) => <li><span class="box" aria-hidden="true"></span>{c}</li>)}</ol>
      <p class="foot">完整說明與來源：{url}<br />按門鈴 doorbell.life・發布 {a.data.publishedAt}，最後查核 {a.data.checkedAt}</p>
      <p class="noprint"><button type="button" onclick="window.print()">列印</button> <a href="../">回到文章</a></p>
    </main>
  </body>
</html>
<style>
  main { max-width: 720px; margin: 0 auto; padding: 32px 16px; }
  h1 { font-size: var(--text-xl); line-height: 1.3; margin: 0 0 24px; }
  ol { list-style: none; padding: 0; counter-reset: c; }
  li { display: flex; gap: 16px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--border-subtle); }
  .box { flex: none; width: 24px; height: 24px; margin-top: 6px; border: 2px solid var(--text-primary); border-radius: 4px; }
  .foot { margin-top: 32px; color: var(--text-secondary); font-size: var(--text-xs); }
  button { font: inherit; font-weight: 600; padding: 12px 24px; border: 0; border-radius: 8px; background: var(--text-primary); color: var(--bg-base); cursor: pointer; }
  @media print { .noprint { display: none; } main { padding: 0; } }
</style>
