---
import { getCollection, render } from "astro:content";
import Base from "../../../../../layouts/Base.astro";

export async function getStaticPaths() {
  const all = await getCollection("articles", (a) => a.data.region === "taiwan");
  return all.map((a) => ({ params: { topic: a.data.topic, slug: a.id.split("/").pop()! }, props: { a } }));
}
const { a } = Astro.props;
const { Content } = await render(a);
const missing = a.data.topic === "missing";
---
<Base title={`${a.data.title}｜按門鈴`} lang="zh-Hant-TW" description={a.data.description} noindex={missing}>
  <main>
    <article>
      <h1>{a.data.title}</h1>
      <Content />
      {a.data.checklist && (
        <section class="checklist">
          <h2>精簡檢查表</h2>
          <ol>{a.data.checklist.map((c) => <li>{c}</li>)}</ol>
          <p><a href="checklist/">列印這張檢查表 →</a></p>
        </section>
      )}
      <h2>資料來源</h2>
      <ul>
        {a.data.sources.map((s) => <li><a href={s.url}>{s.name}</a><span class="muted">（查核 {s.checkedAt}）</span></li>)}
      </ul>
      <p class="muted">發布 {a.data.publishedAt}，最後查核 {a.data.checkedAt}。文章以 CC BY 4.0 授權。</p>
    </article>
  </main>
</Base>
<style>
  .checklist { margin-top: 48px; padding: 24px; background: var(--bg-surface); border-radius: 12px; }
  .checklist li { margin: 8px 0; }
</style>
