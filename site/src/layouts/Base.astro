---
import "../styles/tokens.css";
import Bell from "../components/Bell.astro";
import { CHROME, isRegion, LAUNCHED, REGIONS, REPO, type Region } from "../lib/site";
import { staticRoutes } from "../lib/data";

interface Props {
  title: string;
  description: string;
  // 地區決定語言、導覽與頁尾；不給就看網址第二段（§9 `區塊/地區/內容`），都沒有就是台灣。
  region?: Region;
  lang?: string;
  noindex?: boolean;
  // 同一頁的各地區版本（hreflang）。不給就自動找：把網址的地區換成其他地區，該頁存在就互相標註。
  alternates?: Partial<Record<Region, string>>;
}
const path = Astro.url.pathname;
const seg = path.split("/");
const { title, description, noindex = false } = Astro.props;
const region: Region = Astro.props.region ?? (isRegion(seg[2]) ? seg[2] : "taiwan");
const lang = Astro.props.lang ?? REGIONS[region].lang;
const ui = CHROME[region];

const auto: Partial<Record<Region, string>> = {};
if (isRegion(seg[2])) {
  for (const r of Object.keys(REGIONS) as Region[]) {
    const p = [...seg.slice(0, 2), r, ...seg.slice(3)].join("/");
    if (staticRoutes().has(p)) auto[r] = p;
  }
}
const alt = Object.entries(Astro.props.alternates ?? auto) as [Region, string][];
const alternates = alt.length > 1 ? alt : [];
const others = alternates.filter(([r]) => r !== region);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, noarchive" />}
    {alternates.map(([r, href]) => <link rel="alternate" hreflang={REGIONS[r].hreflang} href={new URL(href, Astro.site).href} />)}
    <title>{title}</title>
  </head>
  <body>
    {!LAUNCHED && <p class="prelaunch">{ui.prelaunch}</p>}
    <header class="top">
      <a class="brand" href={ui.home}><Bell /> {ui.brand} {ui.brand !== "doorbell.life" && <span class="en">doorbell.life</span>}</a>
      <nav>
        {ui.nav.map(([href, label]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}
      </nav>
    </header>
    <slot />
    <footer class="foot">
      <p>{ui.footer}</p>
      {ui.other && others.length > 0 && (
        <p>{ui.other} {others.map(([r, href]) => <a href={href} hreflang={REGIONS[r].hreflang} lang={REGIONS[r].lang}>{REGIONS[r].label}</a>)}</p>
      )}
      <p class="links">{ui.foot.map(([href, label]) => <a href={href}>{label}</a>)}<a href={REPO}>GitHub</a></p>
    </footer>
  </body>
</html>
<style is:global>
  main { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  main h1 { font-size: var(--text-2xl); line-height: 1.25; margin: 40px 0 24px; max-width: 18em; }
  main h2 { font-size: var(--text-xl); margin: 56px 0 16px; }
  main h3 { font-size: var(--text-lg); margin: 32px 0 8px; }
  main p, main li { max-width: 36em; }
  .lead { color: var(--text-secondary); }
  .muted { color: var(--text-secondary); font-size: var(--text-xs); }
  pre { background: var(--bg-overlay); border-radius: 8px; padding: 16px; overflow-x: auto; font-size: var(--text-xs); line-height: 1.5; max-width: 100%; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: var(--text-xs); }
  table { border-collapse: collapse; width: 100%; font-size: var(--text-sm); display: block; overflow-x: auto; }
  th, td { text-align: left; vertical-align: top; padding: 12px; border-bottom: 1px solid var(--border-subtle); }
  th { background: var(--bg-overlay); font-weight: 600; }
</style>
<style>
  .prelaunch { margin: 0; padding: 12px 16px; background: var(--bg-overlay); color: var(--text-primary); font-size: var(--text-xs); text-align: center; }
  .top, .foot { max-width: 1040px; margin: 0 auto; padding: 24px 16px; }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; font-size: var(--text-lg); font-weight: 700; color: var(--text-primary); text-decoration: none; }
  .en { font-weight: 400; color: var(--text-secondary); font-size: var(--text-sm); }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: var(--text-sm); }
  nav a { color: var(--text-secondary); text-decoration: none; }
  nav a[aria-current="page"] { color: var(--text-primary); font-weight: 700; }
  .foot { margin-top: 64px; border-top: 1px solid var(--border-subtle); color: var(--text-secondary); font-size: var(--text-xs); }
  .foot p { margin: 4px 0; }
  .foot .links { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 16px; }
</style>
