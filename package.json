{
  "name": "doorbell-life",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "sync": "pnpm --filter \"./regions/*\" sync",
    "daily": "pnpm sync && pnpm test && pnpm build && pnpm test:e2e",
    "watch-sources": "node .github/scripts/watch-sources.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
