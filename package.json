{
  "name": "doorbell-life-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!@doorbell-life/backend\" build && node .github/scripts/assemble-cdn.ts && pnpm --filter @doorbell-life/backend build",
    "test": "vitest run --passWithNoTests && pnpm --filter @doorbell-life/backend test",
    "test:e2e": "playwright test",
    "sync": "pnpm --filter \"./regions/*\" sync",
    "daily": "pnpm sync && pnpm test && pnpm build && pnpm test:e2e",
    "watch-sources": "node .github/scripts/watch-sources.ts",
    "test:configs": "sh configs/test/run.sh",
    "check-links": "node .github/scripts/check-links.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
