// doorbell.life backend：曝光統計、品牌主登入與設定、報表。契約見 API.md。
// 網域尚未註冊：下面所有 PLACEHOLDER 都要在部署前換成真的值（D1 id 由 `wrangler d1 create doorbell-life` 產生）。
// 本檔不放任何帳號 ID、金鑰；需要的金鑰一律用 `wrangler secret put`。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doorbell-life-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  // 一個 Worker 提供兩個網域（CLAUDE.md §13 網域安排），程式依主機名稱分流（src/app.ts）：
  //   cdn.doorbell.life：靜態資源（下面的 assets）＋ /s 曝光統計 ＋ /b/ 品牌設定與素材（R2）
  //   api.doorbell.life：/auth/*、/brand/*
  // 網域註冊後再開：
  // "routes": [
  //   { "pattern": "cdn.doorbell.life", "custom_domain": true },
  //   { "pattern": "api.doorbell.life", "custom_domain": true }
  // ],
  "workers_dev": false,
  // Workers 靜態資源：根目錄 `pnpm build` 組出的 dist/cdn（元件、樣式、每日資料、時區對應、範本）。
  // 靜態資源請求免費、不限次數，不算 Worker 呼叫；只有 run_worker_first 列的路徑和找不到檔案的請求才會執行 Worker。
  // dist/cdn 裡的 _redirects（/z/{時區}.json → /d/{地區}.json 200）與 _headers（CORS、nosniff）由靜態資源直接套用。
  // 快取沿用靜態資源預設：Cache-Control: public, max-age=0, must-revalidate ＋ ETag（元件更新後下一位訪客就拿到新版）。
  "assets": {
    "directory": "../dist/cdn",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": ["/s", "/b/*"]
  },
  "send_metrics": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "SITE_ORIGIN": "https://doorbell.life",
    "CDN_BASE": "https://cdn.doorbell.life",
    "MAIL_FROM": "login@doorbell.life" // 寄件者；doorbell.life 要先在 Resend 驗證（EMAIL.md）
  },
  // 寄信用 Resend：`wrangler secret put RESEND_API_KEY`（只授權寄信的金鑰）。金鑰不進 repo、不放 vars。
  "secrets": { "required": ["RESEND_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doorbell-life",
      "database_id": "00000000-0000-0000-0000-000000000000", // PLACEHOLDER
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CDN",
      "bucket_name": "doorbell-life-brand" // PLACEHOLDER：品牌設定 b/{id}.json 與品牌素材，需能經 cdn.doorbell.life/b/ 讀到
    }
  ]
}
